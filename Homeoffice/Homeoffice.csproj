<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Name der erzeugten Datei: homeoffice.exe -->
    <AssemblyName>homeoffice</AssemblyName>
    <RootNamespace>Homeoffice</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Excel-Dateien (.xlsx) lesen, ohne dass Excel installiert sein muss -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <!-- Zugriff auf die SQLite-Datenbank (wie im Unterrichtsbeispiel ShowDBAutomation) -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

</Project>
